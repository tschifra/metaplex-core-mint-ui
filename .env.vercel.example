# Copy this file to .env.vercel, replace every placeholder, and import the
# resulting ignored file into Vercel Project Settings > Environment Variables.

# Required public build configuration
NEXT_PUBLIC_CANDY_MACHINE_ID=YOUR_MAINNET_CORE_CANDY_MACHINE
NEXT_PUBLIC_ENVIRONMENT=mainnet-beta
NEXT_PUBLIC_SITE_URL=https://mint.example.com/
NEXT_PUBLIC_SITE_NAME="Example Collection"
NEXT_PUBLIC_SITE_DESCRIPTION="Mint an Example Collection Core asset."

# Mint behavior and Guard presentation
NEXT_PUBLIC_MULTIMINT=false
NEXT_PUBLIC_MAXMINTAMOUNT=5
NEXT_PUBLIC_GUARD_SELECTION_MODE=all
NEXT_PUBLIC_GUARD_LABELS=default:Public Mint,wl:Allowlist Mint,pub:Public Mint
NEXT_PUBLIC_ADMIN_ENABLED=false
NEXT_PUBLIC_MICROLAMPORTS=1001
NEXT_PUBLIC_MINT_PROGRESS_MIN_MS=3000
NEXT_PUBLIC_LUT=
NEXT_PUBLIC_DEVELOPER_FEE_ENABLED=false

# Branding and media
NEXT_PUBLIC_SOCIAL_PREVIEW_IMAGE=/social-preview.webp
NEXT_PUBLIC_HERO_IMAGE=/hero.webp
NEXT_PUBLIC_WORKING_IMAGE=/minting.svg
NEXT_PUBLIC_BACKGROUND_VIDEO=
NEXT_PUBLIC_FAVICON_URL=/icon.svg
NEXT_PUBLIC_APPLE_TOUCH_ICON_URL=/icon.svg
NEXT_PUBLIC_ICON_192_URL=/icon.svg
NEXT_PUBLIC_ICON_512_URL=/icon.svg
NEXT_PUBLIC_FONT_PRESET=audiowide
NEXT_PUBLIC_SHOW_COLLECTION_INFO=false
NEXT_PUBLIC_COLLECTION_DESCRIPTION="Describe the collection here."
NEXT_PUBLIC_CREATOR_NAME="Collection Creator"
NEXT_PUBLIC_CREATOR_IMAGE=
NEXT_PUBLIC_COLLECTION_VERIFIED=false
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_WEBSITE_URL=
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_SHARE_HASHTAGS=SolanaNFT,NFT,MetaplexCore

# Server-only RPC proxy configuration
RPC_URL=https://YOUR_PRIVATE_MAINNET_DAS_RPC
RPC_RATE_LIMIT_PER_MINUTE=180
RPC_TIMEOUT_MS=15000
RPC_ALLOWED_ORIGINS=https://mint.example.com
RPC_REQUIRE_ORIGIN=true

# Server-only mint authorization configuration
# Leave the secret empty only when no effective thirdPartySigner Guard exists.
THIRD_PARTY_SIGNER_SECRET_KEY=
MINT_AUTHORIZATION_MAX_AGE_MS=120000
MINT_RATE_LIMIT_PER_MINUTE=30
MINT_IP_RATE_LIMIT_PER_MINUTE=60
MINT_PAYER_RATE_LIMIT_PER_MINUTE=30
MINT_MAX_COMPUTE_UNITS=1400000
MINT_MAX_PRIORITY_FEE_MICROLAMPORTS=100000
MINT_ALLOWED_ORIGINS=https://mint.example.com
MINT_REQUIRE_ORIGIN=true
