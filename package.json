{
  "name": "core-mint-ui",
  "version": "0.1.0",
  "description": "Configurable Next.js mint UI for Metaplex Core Candy Machine on Solana",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NODE_OPTIONS=--no-experimental-webstorage NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production next build",
    "start": "NODE_OPTIONS=--no-experimental-webstorage next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "npm run lint && npm run typecheck && npm run security:mint-shape && npm test -- --runInBand",
    "security:audit": "npm audit --omit=dev --audit-level=critical",
    "security:mint-shape": "node scripts/checkMintTransactionShape.mjs",
    "guard:check": "node scripts/checkCandyGuard.mjs",
    "guard:third-party": "node scripts/configureThirdPartySigner.mjs"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "glob": "^11.1.0",
    "rimraf": "^6.0.1",
    "inflight": "npm:@zkochan/npm-inflight@1.0.1",
    "shell-quote": "^1.10.0",
    "rpc-websockets": "9.3.8",
    "jayson": {
      "uuid": "11.1.1"
    },
    "merkletreejs": "0.6.0",
    "@metaplex-foundation/mpl-token-metadata": "$@metaplex-foundation/mpl-token-metadata",
    "@metaplex-foundation/mpl-toolbox": "$@metaplex-foundation/mpl-toolbox",
    "jest-environment-jsdom": {
      "jsdom": "27.4.0"
    },
    "ts-jest": {
      "handlebars": "^4.7.9"
    }
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@metaplex-foundation/digital-asset-standard-api": "^2.0.0",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/mpl-core-candy-machine": "^0.3.0",
    "@metaplex-foundation/mpl-core-das": "^0.1.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/mpl-toolbox": "^0.11.4",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-signer-wallet-adapters": "^1.5.1",
    "@metaplex-foundation/umi-web3js-adapters": "^1.5.1",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^5.0.0",
    "framer-motion": "^12.43.0",
    "next": "^16.3.3",
    "react": "^18.3.1",
    "react-confetti": "^6.4.0",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.3.3",
    "@next/eslint-plugin-next": "^16.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "utf-8-validate@6.0.6": true,
    "bufferutil@4.0.9": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.11.1": true
  }
}
