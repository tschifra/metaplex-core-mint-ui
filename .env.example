# ===== CANDY MACHINE CONFIGURATION =====
# Your Core Candy Machine address
NEXT_PUBLIC_CANDY_MACHINE_ID=YOUR_CANDY_MACHINE_ADDRESS

# ===== NETWORK CONFIGURATION =====
# IMPORTANT: Set this to match your Candy Machine's network
# Options: devnet | mainnet-beta
NEXT_PUBLIC_ENVIRONMENT=devnet

# Explorer links adapt to this setting. RPC_URL, the Candy Machine and the
# third-party signer configuration must belong to the same network.

# ===== MINTING SETTINGS =====
# Allow minting multiple NFTs at once
NEXT_PUBLIC_MULTIMINT=false
NEXT_PUBLIC_MAXMINTAMOUNT=5
# "all" preserves selectable Candy Guard groups; "best" shows the cheapest eligible group.
NEXT_PUBLIC_GUARD_SELECTION_MODE=all
# Optional display names for short on-chain group labels.
# Format: label:Display Name,label2:Display Name
NEXT_PUBLIC_GUARD_LABELS=default:Public Mint,wl:Allowlist Mint,pub:Public Mint
# Keep the authority-only admin UI off on customer-facing deployments unless needed.
NEXT_PUBLIC_ADMIN_ENABLED=false

# Mint price in SOL (fallback if candy guard price can't be fetched)
# Set to 0 for free mints

# Priority fees (higher = faster transaction)
NEXT_PUBLIC_MICROLAMPORTS=1001
# Minimum time the mint progress artwork stays visible (0-60000 milliseconds).
NEXT_PUBLIC_MINT_PROGRESS_MIN_MS=3000

# ===== ADVANCED SETTINGS =====
# Lookup table address (generated by admin panel)
NEXT_PUBLIC_LUT=

# Charge the fixed developer fee configured in utils/developerFee.ts
NEXT_PUBLIC_DEVELOPER_FEE_ENABLED=false

# ===== CUSTOMER BRANDING =====
# Public values embedded into the browser bundle at build time.
NEXT_PUBLIC_SITE_URL=https://mint.example.com/
NEXT_PUBLIC_SITE_NAME="My NFT Collection"
NEXT_PUBLIC_SITE_DESCRIPTION="Mint a digital collectible on Solana."
NEXT_PUBLIC_SOCIAL_PREVIEW_IMAGE=/social-preview.webp
NEXT_PUBLIC_HERO_IMAGE=/hero.webp
NEXT_PUBLIC_WORKING_IMAGE=/minting.svg
NEXT_PUBLIC_BACKGROUND_VIDEO=
NEXT_PUBLIC_FAVICON_URL=/icon.svg
NEXT_PUBLIC_APPLE_TOUCH_ICON_URL=/icon.svg
NEXT_PUBLIC_ICON_192_URL=/icon.svg
NEXT_PUBLIC_ICON_512_URL=/icon.svg
NEXT_PUBLIC_FONT_PRESET=audiowide
NEXT_PUBLIC_SHOW_COLLECTION_INFO=false
NEXT_PUBLIC_COLLECTION_DESCRIPTION="Describe the collection here."
NEXT_PUBLIC_CREATOR_NAME="Collection Creator"
NEXT_PUBLIC_CREATOR_IMAGE=
NEXT_PUBLIC_COLLECTION_VERIFIED=false
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_WEBSITE_URL=
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_SHARE_HASHTAGS=SolanaNFT,NFT,MetaplexCore

# Server-only. Never prefix these with NEXT_PUBLIC.
# Solana RPC with DAS support. Put the real credential in .env.local or Vercel.
RPC_URL=https://your-das-rpc.example.com
RPC_RATE_LIMIT_PER_MINUTE=180
RPC_TIMEOUT_MS=15000
RPC_ALLOWED_ORIGINS=
RPC_REQUIRE_ORIGIN=true

# Vercel: set this to either the `[1,2,...]` JSON byte array from wallet.json
# or the base58-encoded 64-byte Solana secret key.
THIRD_PARTY_SIGNER_SECRET_KEY=
# Local development alternative. Set only one signer source.
THIRD_PARTY_SIGNER_KEYPAIR_PATH=
MINT_AUTHORIZATION_MAX_AGE_MS=120000
# Legacy fallback; the separate IP and payer limits below take precedence.
MINT_RATE_LIMIT_PER_MINUTE=30
MINT_IP_RATE_LIMIT_PER_MINUTE=60
MINT_PAYER_RATE_LIMIT_PER_MINUTE=30
MINT_MAX_COMPUTE_UNITS=1400000
MINT_MAX_PRIORITY_FEE_MICROLAMPORTS=100000
MINT_ALLOWED_ORIGINS=
MINT_REQUIRE_ORIGIN=true

# Read-only Guard audit expectations.
THIRD_PARTY_SIGNER_PUBLIC_KEY=
GUARD_REQUIRE_THIRD_PARTY_SIGNER=false
CANDY_GUARD_EXPECTED_AUTHORITY=
CANDY_MACHINE_EXPECTED_COLLECTION=
CANDY_GUARD_EXPECTED_GROUPS=
CANDY_GUARD_PUBLIC_GROUP_LABEL=
GUARD_SNAPSHOT_DIR=.guard-snapshots

# Only needed to update the on-chain Candy Guard. The script is dry-run by default.
CANDY_GUARD_AUTHORITY_KEYPAIR_PATH=/absolute/path/to/candy-guard-authority.json
CANDY_GUARD_CONFIRM_ADDRESS=
APPLY=false

# Optional local build analysis.
ANALYZE=false
